# Local MLflow server used by both the notebook and the FastAPI app.
MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# Registered model name created by the notebook.
MLFLOW_EXPERIMENT_NAME=yellow-taxi-duration
MLFLOW_MODEL_NAME=rfr-ride-duration

# Stable alias the API reads from the MLflow Model Registry.
MODEL_ALIAS=production

# Training data location
TRAIN_DATA_URI=https://d37ci6vzurychx.cloudfront.net/trip-data/yellow_tripdata_2025-01.parquet